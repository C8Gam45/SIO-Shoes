{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="container">
        <h1>Catégories</h1>

        {% include 'layouts/_flash_message.html.twig' %}

        <a href="{{ path('app_category_new') }}" class="btn btn-primary mb-3">
            Ajouter une catégorie
        </a>

        <table class="table">
            <thead>
                <tr>
                    <th>id</th>
                    <th>Nom</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.name }}</td>
                        <td>
                            <a href="{{ path('app_category_update', { id: category.id }) }}" class="btn btn-sm btn-primary">
                                Modifier
                            </a>
                            <a href="{{ path('app_category_delete', { id: category.id }) }}" class="btn btn-sm btn-danger">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Aucune catégorie à afficher.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
