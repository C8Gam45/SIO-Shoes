{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div class="container">
        <br>
        <h1>Produits</h1>

        <div class="home-product-grid">
            {% for product in products %}
                <article class="card home-product-card">
                        {% if product.image %}
                            <a href="{{ path('app_home_product_show', {'id': product.id}) }}">
                                <img
                                    src="{{ asset('uploads/images/images/' ~ product.image) }}"
                                    data-fallback-src="{{ asset('uploads/images/' ~ product.image) }}"
                                    class="card-img-top product-card-image product-image-with-fallback"
                                    alt="{{ product.name }}"
                                >
                            </a>
                        {% else %}
                            <div class="product-card-image-placeholder" role="img" aria-label="Image indisponible">
                                Image indisponible
                            </div>
                        {% endif %}

                        <div class="card-body">
                            <a
                                style="text-decoration: none"
                                href="{{ path('app_home_product_show', {'id': product.id}) }}"
                            >
                                <h5 class="card-title">{{ product.name }}</h5>
                            </a>

                            <p class="card-text text-truncate">{{ product.description }}</p>
                            <h3>{{ product.price }} €</h3>

                            <form method="post" action="{{ path('app_cart_add', { id: product.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="btn btn-outline-success">Ajouter au panier</button>
                            </form>
                        </div>
                </article>
            {% else %}
                <p>Aucun produit disponible.</p>
            {% endfor %}
        </div>

        <br>
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(products, 'layouts/pagination_template.html.twig') }}
        </div>
    </div>
{% endblock %}