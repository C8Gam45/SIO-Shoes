{% extends 'base.html.twig' %}

{% block title %}Your Cart{% endblock %}

{% block body %}
    <div class="container">
        <br>
        <h1>Votre panier</h1>
        {% include 'layouts/_flash_message.html.twig' %}
        <br>

        {% if items is empty %}
            <p>Votre panier est vide.</p>
        {% else %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Nom du produit</th>
                        <th>Quantité</th>
                        <th>Prix</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>{{ item.product.name }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.product.price|number_format(2, ',', ' ') }} €</td>
                            <td>
                                {{ (item.product.price * item.quantity)|number_format(2, ',', ' ') }} €
                            </td>
                            <td>
                                <form method="post" action="{{ path('app_cart_remove', {'id': item.product.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('cart_remove_' ~ item.product.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="d-flex justify-content-end">
                <h4>Total : {{ total|number_format(2, ',', ' ') }} €</h4>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="{{ path('app_order') }}" data-turbo="false" class="btn btn-primary">Valider et payer</a>
                <form method="post" action="{{ path('app_cart_clear') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                    <button type="submit" class="btn btn-danger">Vider le panier</button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}