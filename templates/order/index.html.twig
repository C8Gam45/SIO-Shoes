{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block body %}
    <main class="container py-4">
        {% include 'layouts/_flash_message.html.twig' %}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Commandes</h1>
            <a href="{{ path('app_order_new') }}" class="btn btn-primary">Créer une commande</a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Client</th>
                        <th>Produits</th>
                        <th>Livraison</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>{{ order.id }}</td>
                            <td>{{ order.firstName }} {{ order.lastName }}</td>
                            <td>
                                {% for line in order.orderProducts %}
                                    <div>{{ line.product.name }} × {{ line.qte }}</div>
                                {% else %}
                                    <span class="text-muted">Aucun détail produit</span>
                                {% endfor %}
                            </td>
                            <td>{{ order.shippingPrice|number_format(2, ',', ' ') }} €</td>
                            <td>{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>
                            <td>{{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '' }}</td>
                            <td class="text-nowrap">
                                <a href="{{ path('app_order_edit', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <form method="post" action="{{ path('app_order_delete', {id: order.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette commande ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center">Aucune commande enregistrée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}
