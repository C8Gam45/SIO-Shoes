{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
    <main class="container py-4">
        {% include 'layouts/_flash_message.html.twig' %}
        <h1>Commande confirmée</h1>
        <p>Votre commande n°{{ order.id }} a été enregistrée le {{ order.createdAt|date('d/m/Y H:i') }}.</p>
        <h2 class="h4 mt-4">Articles commandés</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Prix unitaire</th>
                        <th>Quantité</th>
                        <th>Sous-total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in order.orderProducts %}
                        <tr>
                            <td>{{ line.product.name }}</td>
                            <td>{{ line.price|number_format(2, ',', ' ') }} €</td>
                            <td>{{ line.qte }}</td>
                            <td>{{ (line.price * line.qte)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">Aucun détail de produit n’est disponible pour cette commande.</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Frais de livraison</th>
                        <td>{{ order.shippingPrice|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    <tr>
                        <th colspan="3">Total</th>
                        <td>{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <a href="{{ path('app_home') }}" class="btn btn-primary">Continuer mes achats</a>
    </main>
{% endblock %}
