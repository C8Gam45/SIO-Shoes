{% extends 'base.html.twig' %}

{% block title %}Ajout de produits au stock{% endblock %}

{% block body %}
    <main class="container py-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 card-title mb-4">Ajouter au stock de {{ product.name }}</h1>

                {% include 'layouts/_flash_message.html.twig' %}

                {{ form_start(form) }}
                    {{ form_row(form.qte, {
                        label: 'Quantité',
                        attr: { class: 'form-control', min: 1 }
                    }) }}

                    <button class="btn btn-success">
                        {{ button_label|default('Enregistrer') }}
                    </button>
                {{ form_end(form) }}

                <a class="btn btn-link mt-3 px-0" href="{{ path('app_product_index') }}">Retour aux produits</a>
            </div>
        </div>
    </main>
{% endblock %}
