{% extends 'base.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block body %}
    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Produits</h1>
            <a class="btn btn-primary" href="{{ path('app_product_new') }}">Ajouter un produit</a>
        </div>

        {% include 'layouts/_flash_message.html.twig' %}

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Description</th>
                        <th scope="col">Prix</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>{{ product.name }}</td>
                        <td>{{ product.description|default('')|slice(0, 100) }}{% if product.description|default('')|length > 100 %}…{% endif %}</td>
                        <td>{{ product.price }}</td>
                        {% if product.stock > 0 %}
                            <td>{{ product.stock }}</td>
                        {% else %}
                            <td><span class="text-danger">Stock épuisé</span></td>
                        {% endif %}
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_product_show', { id: product.id }) }}">Afficher</a>
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_product_edit', { id: product.id }) }}">Modifier</a>
                            <a class="btn btn-outline-info" href="{{ path('app_product_stock_add', { id: product.id }) }}">Ajout stock</a>
                            <a class="btn btn-sm btn-outline-dark" href="{{ path('app_product_stock_add_history', { id: product.id }) }}">Historique du stock</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucun produit à afficher.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}
